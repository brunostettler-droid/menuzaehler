<script>
function showPage(which){
 let sales=document.getElementById("salesPage"), journal=document.getElementById("journalPage");
 let ns=document.getElementById("navSales"), nj=document.getElementById("navJournal");
 if(which==="journal"){sales.style.display="none";journal.style.display="block";ns.style.display="inline-block";nj.style.display="none";renderJournal();}
 else{sales.style.display="block";journal.style.display="none";ns.style.display="none";nj.style.display="inline-block";}
 window.scrollTo(0,0);
}
const MENUS=[
 {id:"m1",name:"Menü 1",price:15},{id:"m2",name:"Menü 2",price:15},
 {id:"m3",name:"Menü 3",price:15},{id:"m4",name:"Menü 4",price:15},
 {id:"spiess",name:"Spiesschen",price:15},{id:"chnus",name:"Chnusperli",price:12},
 {id:"div",name:"Diverses",price:10}
];
const PAY={B:"Bar",T:"TWINT",KK:"Kreditkarte"};
const KEY="tfk_menuzaehler_v3";
let db=load();
function localDate(d=new Date()){let y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,"0"),day=String(d.getDate()).padStart(2,"0");return `${y}-${m}-${day}`}
function emptyDay(){let menus={};MENUS.forEach(m=>menus[m.id]={B:0,T:0,KK:0});return {menus,transactions:[],closed:false}}
function load(){
 try{
   let raw=localStorage.getItem(KEY);
   if(raw)return JSON.parse(raw);
 }catch(e){}
 return {days:{}};
}
function save(){
 try{
   localStorage.setItem(KEY,JSON.stringify(db));
   localStorage.setItem(KEY+"_lastsave",new Date().toISOString());
   showSaveState("✓ gespeichert");
   return true;
 }catch(e){
   showSaveState("⚠ Speicherung blockiert – bitte Backup nutzen");
   return false;
 }
}
function showSaveState(txt){
 let el=document.getElementById("saveState");
 if(el)el.textContent=txt;
}
function ensureToday(){let k=localDate();if(!db.days[k]){db.days[k]=emptyDay();save()}return db.days[k]}
function money(n){return "Fr. "+Number(n).toLocaleString("de-CH",{minimumFractionDigits:0,maximumFractionDigits:2})+".–"}
function menuStats(day,m){let x=day.menus[m.id]||{B:0,T:0,KK:0},count=x.B+x.T+x.KK;return {x,count,revenue:count*m.price}}
function dayStats(day){let pc={B:0,T:0,KK:0},pr={B:0,T:0,KK:0},count=0,revenue=0;
 MENUS.forEach(m=>{let s=menuStats(day,m);count+=s.count;revenue+=s.revenue;for(let p in pc){pc[p]+=s.x[p];pr[p]+=s.x[p]*m.price}});
 return {pc,pr,count,revenue}
}
function book(id,pay){
 let day=ensureToday(); if(day.closed && !confirm("Dieser Tag wurde abgeschlossen. Trotzdem buchen?"))return;
 let m=MENUS.find(x=>x.id===id);day.menus[id][pay]++;day.transactions.push({id,pay,price:m.price,time:new Date().toISOString()});save();render();
}
function undoLast(){
 let day=ensureToday(),t=day.transactions.pop();if(!t){alert("Keine Buchung zum Rückgängigmachen.");return}
 if(day.menus[t.id] && day.menus[t.id][t.pay]>0)day.menus[t.id][t.pay]--;save();render();
}
function closeDay(){let d=ensureToday();if(confirm("Heutigen Tag abschliessen? Die Daten bleiben im Journal.")){d.closed=true;save();render()}}
function render(){
 let day=ensureToday();document.getElementById("date").textContent=new Date().toLocaleDateString("de-CH",{weekday:"short",day:"2-digit",month:"2-digit",year:"numeric"})+(day.closed?" · abgeschlossen":"");
 MENUS.forEach(m=>{let st=menuStats(day,m);let c=document.getElementById("card-"+m.id);
 if(c)c.innerHTML=`<h2>${m.name}</h2><div class="price">${money(m.price)}</div><div class="count">${st.count}</div><div class="revenue">${money(st.revenue)}</div>
 <div class="pay">${["B","T","KK"].map(p=>`<button class="${p==="B"?"b":p==="T"?"t":"kk"}" onclick="book('${m.id}','${p}')">${p}<span class="mini">${st.x[p]}×</span></button>`).join("")}</div>`;});
 let s=dayStats(day);
 document.getElementById("allCount").textContent=s.count;
 document.getElementById("allRevenue").textContent=money(s.revenue);
 document.getElementById("barTotal").textContent=`${s.pc.B} · ${money(s.pr.B)}`;
 document.getElementById("twintTotal").textContent=`${s.pc.T} · ${money(s.pr.T)}`;
 document.getElementById("cardTotal").textContent=`${s.pc.KK} · ${money(s.pr.KK)}`;
 updateMonths();renderJournal();
}
function updateMonths(){
 let sel=document.getElementById("monthSelect"),current=sel.value||localDate().slice(0,7);let months=[...new Set([...Object.keys(db.days).map(d=>d.slice(0,7)),localDate().slice(0,7)])].sort().reverse();
 sel.innerHTML=months.map(m=>`<option value="${m}" ${m===current?"selected":""}>${m.split("-").reverse().join(".")}</option>`).join("");
}
function renderJournal(){
 let month=document.getElementById("monthSelect").value||localDate().slice(0,7),days=Object.keys(db.days).filter(d=>d.startsWith(month)).sort(),tot={count:0,rev:0,B:0,T:0,KK:0,Br:0,Tr:0,KKr:0},menuTot={};MENUS.forEach(m=>menuTot[m.id]=0);
 let rows=days.map(k=>{let d=db.days[k],s=dayStats(d);tot.count+=s.count;tot.rev+=s.revenue;["B","T","KK"].forEach(p=>{tot[p]+=s.pc[p]});tot.Br+=s.pr.B;tot.Tr+=s.pr.T;tot.KKr+=s.pr.KK;
 let ms=MENUS.map(m=>{let z=menuStats(d,m);menuTot[m.id]+=z.count;return `<td>${z.count}</td>`}).join("");
 return `<tr><td>${k.split("-").reverse().join(".")}</td>${ms}<td>${s.pc.B} / ${money(s.pr.B)}</td><td>${s.pc.T} / ${money(s.pr.T)}</td><td>${s.pc.KK} / ${money(s.pr.KK)}</td><td><b>${s.count}</b></td><td><b>${money(s.revenue)}</b></td></tr>`}).join("");
 let heads=MENUS.map(m=>`<th>${m.name}</th>`).join(""),foots=MENUS.map(m=>`<td>${menuTot[m.id]}</td>`).join("");
 document.getElementById("journalTable").innerHTML=`<table><thead><tr><th>Datum</th>${heads}<th>Bar</th><th>TWINT</th><th>KK</th><th>Stück</th><th>Umsatz</th></tr></thead><tbody>${rows||'<tr><td colspan="13">Noch keine Buchungen.</td></tr>'}</tbody><tfoot><tr><td>Monat total</td>${foots}<td>${tot.B} / ${money(tot.Br)}</td><td>${tot.T} / ${money(tot.Tr)}</td><td>${tot.KK} / ${money(tot.KKr)}</td><td>${tot.count}</td><td>${money(tot.rev)}</td></tr></tfoot></table>`;
}
function exportBackup(){
 try{
   save();
   let payload={app:"Thai Food Kurier Menü-Zähler",version:30,exportedAt:new Date().toISOString(),data:db};
   let blob=new Blob([JSON.stringify(payload,null,2)],{type:"application/json"});
   let a=document.createElement("a");
   a.href=URL.createObjectURL(blob);
   a.download=`Menuezaehler-Backup-${localDate()}.json`;
   document.body.appendChild(a);a.click();a.remove();
   setTimeout(()=>URL.revokeObjectURL(a.href),1000);
 }catch(e){alert("Backup konnte nicht erstellt werden.");}
}
function importBackup(ev){
 let file=ev.target.files&&ev.target.files[0]; if(!file)return;
 let reader=new FileReader();
 reader.onload=function(){
   try{
     let obj=JSON.parse(reader.result);
     let incoming=obj.data||obj;
     if(!incoming || typeof incoming!=="object" || !incoming.days)throw new Error();
     if(!confirm("Backup wirklich wiederherstellen? Der aktuelle Datenstand wird ersetzt."))return;
     db=incoming;save();ensureToday();render();showSaveState('✓ bereit – Änderungen werden sofort gespeichert');alert("Backup wurde wiederhergestellt.");
   }catch(e){alert("Diese Datei ist kein gültiges Menü-Zähler-Backup.");}
   ev.target.value="";
 };
 reader.readAsText(file);
}
function exportCSV(){
 let month=document.getElementById("monthSelect").value||localDate().slice(0,7),days=Object.keys(db.days).filter(d=>d.startsWith(month)).sort();
 let header=["Datum",...MENUS.map(m=>m.name),"Bar Stück","Bar CHF","TWINT Stück","TWINT CHF","KK Stück","KK CHF","Total Stück","Total CHF"];
 let lines=[header.join(";")];
 days.forEach(k=>{let d=db.days[k],s=dayStats(d),vals=[k,...MENUS.map(m=>menuStats(d,m).count),s.pc.B,s.pr.B.toFixed(2),s.pc.T,s.pr.T.toFixed(2),s.pc.KK,s.pr.KK.toFixed(2),s.count,s.revenue.toFixed(2)];lines.push(vals.join(";"))});
 let blob=new Blob(["\ufeff"+lines.join("\n")],{type:"text/csv;charset=utf-8"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=`Menue-Journal-${month}.csv`;a.click();URL.revokeObjectURL(a.href);
}
ensureToday();render();
</script>
</body></html>